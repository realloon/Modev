<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <OutputPath>../1.7/Assemblies</OutputPath>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <PropertyGroup>
        <RimWorld17Dir>$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app/Contents/MacOS</RimWorld17Dir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.2" />
        <Reference Include="$(RimWorld17Dir)/*.dll" Private="false" Exclude="$(RimWorld17Dir)/System.*.dll;$(RimWorld17Dir)/Microsoft.*.dll;$(RimWorld17Dir)/netstandard.dll;$(RimWorld17Dir)/mscorlib.dll" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Modev.sln.DotSettings" />
        <None Remove="Modev.csproj.DotSettings" />
    </ItemGroup>

</Project>